#!/usr/bin/env bash
# install — build chef, install it on PATH, and optionally add Cargo shell hook
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
cd "$root"

dry_run=false
modify_shell=true
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --no-shell-modification) modify_shell=false ;;
    -h|--help)
      cat <<'EOF'
Usage: ./install [OPTIONS]

Build and install chef. Options:
  --dry-run                  Show actions without changing system or building
  --no-shell-modification   Do not edit shell startup files
  -h, --help                Show this help
EOF
      exit 0
      ;;
    *) err "unknown option: $arg"; exit 2 ;;
  esac
done

cargo_env='. "$HOME/.cargo/env"'
cargo_bin_line='export PATH="$HOME/.cargo/bin:$PATH"'

say() { printf '%s\n' "$*"; }
err() { printf 'install: %s\n' "$*" >&2; }

ensure_rust() {
  if [[ "$dry_run" == true ]]; then
    say "install: would check for Rust/Cargo"
    return 0
  fi
  if [[ -f "$HOME/.cargo/env" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/.cargo/env"
  fi
  if command -v cargo >/dev/null 2>&1; then
    return 0
  fi
  err "Cargo not found — install Rust from https://rustup.rs, then rerun ./install"
  exit 1
}

profile_file() {
  case "${SHELL:-}" in
    */zsh) echo "$HOME/.zshrc" ;;
    */bash)
      if [[ -f "$HOME/.bash_profile" ]]; then
        echo "$HOME/.bash_profile"
      else
        echo "$HOME/.bashrc"
      fi
      ;;
    *) echo "$HOME/.profile" ;;
  esac
}

ensure_path_hook() {
  local profile
  profile="$(profile_file)"
  if [[ "$modify_shell" == false ]]; then
    say "install: skipping shell profile modification"
    return 0
  fi
  if [[ "$dry_run" == true ]]; then
    say "install: would add Cargo environment to $profile"
    return 0
  fi
  if [[ ! -f "$profile" ]]; then
    touch "$profile"
  fi
  if grep -qF '. "$HOME/.cargo/env"' "$profile" 2>/dev/null \
    || grep -qF "source \"\$HOME/.cargo/env\"" "$profile" 2>/dev/null; then
    say "install: cargo env already in $profile"
    return 0
  fi
  {
    echo ""
    echo "# rust / cargo (added by chef install)"
    echo "$cargo_env"
  } >>"$profile"
  say "install: added cargo env to $profile"
}

build_and_install() {
  if [[ "$dry_run" == true ]]; then
    say "install: would run cargo build"
    say "install: would run cargo install --path . --force"
    return 0
  fi
  say "install: cargo build"
  cargo build
  say "install: cargo install --path ."
  cargo install --path . --force
}

verify() {
  if command -v chef >/dev/null 2>&1; then
    say "install: chef -> $(command -v chef)"
    chef --version 2>/dev/null || chef --help | head -1
    return 0
  fi
  if [[ -x "$HOME/.cargo/bin/chef" ]]; then
    say "install: chef -> $HOME/.cargo/bin/chef"
    say "install: open a new shell or: source $(profile_file)"
    return 0
  fi
  err "chef not found after install"
  exit 1
}

main() {
  say "install: repo $root"
  ensure_rust
  ensure_path_hook
  build_and_install
  if [[ "$dry_run" == true ]]; then
    say "install: dry run complete"
    return 0
  fi
  verify
  say ""
  say "done. open a new terminal, then:"
  say "  chef"
  say ""
  say "reinstall after pulling: chef prep"
}

main "$@"
